# ── أساسي ───────────────────────────────────────────────
# مفتاح Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
# مفتاح Soniox (تحويل الصوت لنص عربي لحظي + فصل المتحدثين) — https://console.soniox.com
SONIOX_API_KEY=
# كلمة سر الدخول للتطبيق (إلزامية عند النشر على الإنترنت)
APP_PASSWORD=
# الرابط العام للتطبيق (بدون / في الآخر)
BASE_URL=http://localhost:8787
PORT=8787

# ── Google (Sheets / Docs / Gmail / Calendar) ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── اختياري ─────────────────────────────────────────────
# اسمك ودورك — Claude بيستخدمهم عشان يوجّه الاقتراحات ليك
OWNER_NAME=
OWNER_ROLE=
CLAUDE_MODEL=claude-opus-5-5
SONIOX_MODEL=stt-rt-preview
TIMEZONE=Africa/Cairo
# إيميل متابعة يومي بالمهام المستحقة (1 = مفعّل) والساعة المحلية
DIGEST=0
DIGEST_HOUR=9
DATA_DIR=./data
